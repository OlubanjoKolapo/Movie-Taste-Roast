# Copy to .env for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Server-side keys (never exposed to the browser):

# AI roast copy. Without a key, the built-in roast engine writes everything.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional alternative: AI_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=grok-4-fast-non-reasoning

# TMDb search for titles outside the built-in catalogue (free key at themoviedb.org/settings/api).
TMDB_API_KEY=
# or a v4 read token instead:
TMDB_READ_TOKEN=

# Browser-side (VITE_ prefix is public):
VITE_SITE_URL=https://movieroast.ai
VITE_MOVIETONIGHT_URL=https://movietonight.ai/
# When MovieTonight exposes a public taste endpoint, set it here. GET {url}/{handle} → { items: [{ key: "m27205", rating?: 9 }] }
VITE_MOVIETONIGHT_IMPORT_URL=
